{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/fx/sync",
      "schedule": "30 16 * * 1-5"
    },
    {
      "path": "/api/report/monthly",
      "schedule": "0 23 28-31 * *"
    },
    {
      "path": "/api/report/period?store=1",
      "schedule": "0 6 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
